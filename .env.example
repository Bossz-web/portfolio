# ---------------------------------------------------------------------------
# Contact form (Resend) — optional
# ---------------------------------------------------------------------------
# The contact form works without these set: it validates input and returns a
# friendly "email isn't configured yet" message instead of sending. To enable
# real delivery, create a free key at https://resend.com and fill these in.
#
# This file is a TEMPLATE and is committed to git — never put real secrets here.
# Copy it to `.env.local` (which is gitignored) and put real values there:
#   cp .env.example .env.local

# API key from the Resend dashboard (starts with "re_").
RESEND_API_KEY=

# Where contact submissions are delivered (your inbox).
# NOTE: while using the shared sandbox sender below, Resend will ONLY deliver to
# the email address that owns your Resend account. Verify a domain to send
# anywhere else.
CONTACT_TO_EMAIL=

# The "from" address. Must be on a domain you've verified in Resend.
# Resend's shared sandbox sender works for testing: onboarding@resend.dev
CONTACT_FROM=Portfolio <onboarding@resend.dev>
